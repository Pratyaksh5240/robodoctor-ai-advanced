AI_HEALTH_ASSISTANT_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key
AI_HEALTH_ASSISTANT_GEMINI_MODEL=gemini-2.0-flash

GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1
AI_HEALTH_ASSISTANT_VERTEX_MODEL=gemini-2.0-flash

# Choose one Vertex auth option:
VERTEX_AI_ACCESS_TOKEN=
GOOGLE_VERTEX_SERVICE_ACCOUNT_PATH=
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=

# Optional service-account fields if you prefer separate env vars:
GOOGLE_VERTEX_CLIENT_EMAIL=
GOOGLE_VERTEX_PRIVATE_KEY=
GOOGLE_VERTEX_TOKEN_URI=https://oauth2.googleapis.com/token
